<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep credential/token stores local-only. -->
        <exclude domain="file" path="datastore/navidrome_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/spotify_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="navidrome_secure_prefs.xml" />
        <exclude domain="sharedpref" path="spotify_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/navidrome_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/spotify_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="navidrome_secure_prefs.xml" />
        <exclude domain="sharedpref" path="spotify_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>