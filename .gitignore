# ============================================================
# TigerPlayer .gitignore
#
# Pattern-based by design. Do NOT let tooling append individual
# generated file paths here - use directory patterns instead.
# ============================================================
# ---------- Gradle ----------
.gradle/
build/
captures/
!gradle/wrapper/gradle-wrapper.jar
# ---------- Android build output ----------
app/build/
app/release/
*/build/
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json
# ---------- Native ----------
.externalNativeBuild/
.cxx/
obj/
# ---------- IDE: IntelliJ / Android Studio ----------
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/misc.xml
.idea/gradle.xml
.idea/compiler.xml
.idea/jarRepositories.xml
.idea/shelf/
# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
# ---------- Logs & temp ----------
*.log
*.hprof
*.tmp
.kotlin/
.gitignore.bak
# ============================================================
# Security - credential & signing material
# Pattern-based so newly added files are covered automatically.
# ============================================================
*.jks
*.keystore
*.p12
*.pem
secrets.properties
local.properties
keystore.properties
signing.properties
google-services.json
